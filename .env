# Supabase — projet « Class'it » (djodkjysovalpufgevrr)
# La clé publishable est conçue pour être publique (protégée par RLS) ; elle est
# de toute façon embarquée dans le build statique. Committée volontairement.
VITE_SUPABASE_URL=https://djodkjysovalpufgevrr.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_pUCXLrBR3cogEC6ZDP2aJA_qBJOdr37

# URL publique du site déployé : sert à construire les liens absolus
# (QR codes, lien dans l'email de notification) — toujours vers la prod,
# même si générés/envoyés depuis le localhost.
VITE_SITE_URL=https://qwetsh.github.io/parc-numerique/

# EmailJS — notification au référent à chaque signalement.
#
# La notification part du SERVEUR : trigger SQL sur parc_signalements →
# edge function « notify-signalement » → API EmailJS. Fiable quel que soit
# l'appareil de l'enseignant, et les identifiants restent des secrets Supabase.
#
# VITE_NOTIF_NAVIGATEUR=true réactiverait le canal de secours depuis le
# navigateur : à ne faire que si le canal serveur tombe, sinon chaque
# signalement enverra DEUX emails. Les trois identifiants ci-dessous ne
# servent qu'à ce canal de secours (clé publique, destinée au navigateur).
VITE_NOTIF_NAVIGATEUR=false
VITE_EMAILJS_SERVICE_ID=service_iu8wp79
VITE_EMAILJS_TEMPLATE_ID=template_zs655ab
VITE_EMAILJS_PUBLIC_KEY=sYPO8mRAvfvPSxc3k
